#!/usr/bin/env python3
"""Reflect Ollama's loaded-model RAM allocation on Framework Desktop ARGB LEDs."""

import colorsys
import json
import logging
import os
import subprocess
import time
import urllib.error
import urllib.request


OLLAMA_PS_URL = os.getenv("OLLAMA_PS_URL", "http://127.0.0.1:11434/api/ps")
FRAMEWORK_TOOL = os.getenv("FRAMEWORK_TOOL", "/usr/bin/framework_tool")
LED_COUNT = int(os.getenv("LED_COUNT", "8"))
POLL_SECONDS = float(os.getenv("POLL_SECONDS", "2"))


def physical_ram_bytes():
    with open("/proc/meminfo", encoding="ascii") as meminfo:
        for line in meminfo:
            if line.startswith("MemTotal:"):
                return int(line.split()[1]) * 1024
    raise RuntimeError("MemTotal not found in /proc/meminfo")


def ollama_models():
    with urllib.request.urlopen(OLLAMA_PS_URL, timeout=1.5) as response:
        return json.load(response).get("models", [])


def utilization_color(models, total_ram):
    if not models:
        return 0xFFFFFF, 0.0

    # Ollama's /api/ps `size` is the memory allocated for each loaded model.
    loaded_bytes = sum(max(0, int(model.get("size", 0))) for model in models)
    fraction = min(1.0, loaded_bytes / total_ram)

    # Clamp the bottom of the requested scale at 1%: green=120 degrees, red=0.
    scaled = (max(0.01, fraction) - 0.01) / 0.99
    hue = (120.0 * (1.0 - scaled)) / 360.0
    red, green, blue = colorsys.hsv_to_rgb(hue, 1.0, 1.0)
    color = (round(red * 255) << 16) | (round(green * 255) << 8) | round(blue * 255)
    return color, fraction


def set_leds(color):
    value = f"0x{color:06X}"
    subprocess.run(
        [FRAMEWORK_TOOL, "--rgbkbd", "0", *([value] * LED_COUNT)],
        check=True,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
    )


def main():
    logging.basicConfig(level=logging.INFO, format="%(levelname)s %(message)s")
    total_ram = physical_ram_bytes()
    previous = None

    while True:
        try:
            models = ollama_models()
            color, fraction = utilization_color(models, total_ram)
            state = (color, tuple(sorted(model.get("name", "") for model in models)))
            description = (
                "Ollama idle" if not models else
                f"{len(models)} model(s), {fraction:.1%} of RAM"
            )
        except (OSError, ValueError, urllib.error.URLError, json.JSONDecodeError) as error:
            color, state, description = 0x000000, (0x000000, ()), "Ollama unavailable"
            logging.debug("Ollama check failed: %s", error)

        if state != previous:
            try:
                set_leds(color)
                logging.info("%s -> #%06X", description, color)
                previous = state
            except (OSError, subprocess.CalledProcessError) as error:
                logging.error("Could not set Framework RGB LEDs: %s", error)

        time.sleep(POLL_SECONDS)


if __name__ == "__main__":
    main()
