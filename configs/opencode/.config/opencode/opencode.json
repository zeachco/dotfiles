{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    "file:///home/olivier/dotfiles/configs/opencode/.config/opencode/plugins/llamacpp-model-sync.ts"
  ],
  "default_agent": "brainstorm",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "alibaba-cn/qwen3-8b",
      // "prompt": "{file:./prompts/build.txt}",
      "permission": {
        "edit": "allow",
        "bash": "allow"
      }
    },
    "plan": {
      "mode": "primary",
      "model": "alibaba-cn/qwen3-8b",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "brainstorm": {
      "mode": "all",
      "description": "Devil's advocate, ideas disproofing or proposing plan mutations, basically challenging assumptions, defining task expectations and going in depth",
      "model": "alibaba-cn/qwen3-8b",
      "prompt": "You are a brainstorm agent. You can access current system tools to prove ideas or explore around, but should not make edits.",
      "permission": {
        "edit": "deny",
        "bash": "allow"
      }
    },
    "generate-code": {
      "description": "Sub agent used to generate large chunks of coded and keep the main orchestrer with lighter tokens, optimized for fast code generation",
      "mode": "subagent",
      "model": "alibaba-cn/qwen2-5-coder-32b-instruct",
      "permission": {
        "edit": "deny",
        "bash": "deny"
      }
    },
    "code-reviewer": {
      "description": "Reviews code for best practices and potential issues",
      "mode": "subagent",
      "model": "alibaba-cn/qwen3-8b",
      "prompt": "You are a code reviewer. Focus on security, performance, and maintainability.",
      "permission": {
        "edit": "deny"
      }
    }
  },
  "provider": {
    "llamacpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp",
      "options": {
        "baseURL": "http://oli-llms.local:8080/v1",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "qwen3.8": {
          "name": "Qwen3.8 27B (light tier)",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "tool_call": true,
          "attachment": true,
          "reasoning": true
        },
        "Qwen3-Coder-Next-UD-IQ4_XS": {
          "name": "Qwen3 Coder Next 80B-A3B (light tier)",
          "limit": {
            "context": 65536,
            "output": 32768
          },
          "tool_call": true,
          "attachment": false,
          "reasoning": true
        },
        "GLM-4.7-Flash-UD-Q4_K_XL": {
          "name": "GLM-4.7 Flash (light tier, fan-out)",
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "tool_call": true,
          "attachment": false,
          "reasoning": true
        },
        "Ministral-3-3B-Instruct-2512-Q4_K_M": {
          "name": "Ministral-3-3B-Instruct-2512-Q4_K_M"
        },
        "Qwen3-4B-Q4_K_M": {
          "name": "Qwen3-4B-Q4_K_M"
        },
        "gemma-4-26B-A4B-it-GGUF": {
          "name": "gemma-4-26B-A4B-it-GGUF"
        },
        "gemma-4-E2B-it-GGUF": {
          "name": "gemma-4-E2B-it-GGUF"
        },
        "gemma-4-E4B-it-GGUF": {
          "name": "gemma-4-E4B-it-GGUF"
        },
        "qwen2.5-coder-0.5b-instruct-q4_k_m": {
          "name": "qwen2.5-coder-0.5b-instruct-q4_k_m"
        },
        "Qwen3.8-Flash-Next": {
          "name": "Qwen3.8-Flash-Next"
        }
      }
    },
    "llamacpp-olim3": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp (olim3)",
      "options": {
        "baseURL": "http://olim3.local:8080/v1",
        "timeout": false,
        "headerTimeout": false
      },
      "models": {
        "Qwen3.8-27B": {
          "name": "Qwen3.8 27B (olim3)",
          "limit": {
            "context": 131072,
            "output": 32768
          },
          "tool_call": true,
          "attachment": true,
          "reasoning": true
        },
        "gemma-4-E4B-it": {
          "name": "Gemma 4 E4B (olim3)",
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "tool_call": true,
          "attachment": true,
          "reasoning": false
        },
        "gemma-4-E2B-it": {
          "name": "Gemma 4 E2B (olim3, fan-out)",
          "limit": {
            "context": 65536,
            "output": 16384
          },
          "tool_call": true,
          "attachment": true,
          "reasoning": false
        }
      }
    }
  },
  "model": "llamacpp/qwen3.8",
  "small_model": "llamacpp/qwen3.8"
}
