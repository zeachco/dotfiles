{
  "defaultProvider": "llamacpp",
  "defaultModel": "qwen3.8",
  "defaultThinkingLevel": "high",
  "compaction": {
    "modelOverrides": {
      "llamacpp/qwen3.8": {
        "reserveTokens": 32768
      }
    }
  },
  "enabledModels": [
    "openai-codex/gpt-5.6-luna",
    "llamacpp/qwen3.8",
    "openrouter/*"
  ],
  "packages": [
    "npm:@openlines/openpi-memory",
    "npm:pi-subagents",
    "npm:@juicesharp/rpiv-todo",
    "npm:@mjasnikovs/pi-task",
    "npm:pi-session-summary"
  ],
  "theme": "light/dark",
  "lastChangelogVersion": "1.3.0",
  "editorPaddingX": 1,
  "outputPad": 1,
  "terminal": {
    "showTerminalProgress": true
  },
  "steeringMode": "all",
  "collapseChangelog": true,
  "enableInstallTelemetry": false,
  "defaultProjectTrust": "ask",
  "treeFilterMode": "default",
  "tuiMode": "fullscreen"
}
