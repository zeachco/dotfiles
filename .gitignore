themes/current

# Machine-local theme state (created before the matching Stow package is linked)
configs/alacritty/.config/alacritty/theme.toml

# Auto-generated by herdr (reinstalling the integration overwrites these)
configs/pi/.pi/agent/extensions/herdr-agent-state.ts
configs/opencode/.config/opencode/plugins/herdr-agent-state.js

# Live OAuth credentials (access + refresh tokens) written by pi on login/refresh
configs/pi/.pi/agent/auth.json

# Machine-local llama.cpp model list: every box serves different models (the mac
# router has Qwen3.8-27B, the linux one qwen3.8 and the gemmas), and `los` sync-models
# deletes whatever the local router does not serve -- so a tracked copy flips on every
# sync. Seeded from models.seed.json by setup, then filled in per machine.
configs/pi/.pi/agent/models.json

# Machine-local pi model-store cache
configs/pi/.pi/agent/models-store.json

# Machine-local opencode config: llamacpp-sync rewrites the llamacpp* and openrouter
# model lists (OpenRouter's catalog changes weekly), and each box serves different models.
# Seeded from opencode.seed.json by setup, which carries the hand-maintained parts with empty
# model lists -- so the auto-updated catalog never reaches git.
configs/opencode/.config/opencode/opencode.json

# Machine-local herdr config: the server rewrites it (onboarding, channel, `herdr update`
# regenerates it wholesale), bin/herdr-config patches theme.name and appends the [keys]
# table. Seeded from configs/herdr/config.seed.toml by setup, only when absent.
configs/herdr/.config/herdr/config.toml
