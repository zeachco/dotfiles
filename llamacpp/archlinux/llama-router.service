# TEMPLATE -- installed to ~/.config/systemd/user by install.sh in this directory.
#
# THE router: one llama-server in router mode on :7070, serving ~/models/llama with
# models.ini, and loading NOTHING on its own (--no-models-autoload). Every load is an
# explicit `los` / `los-load` / POST /models/load; a request for a model that is not
# resident is refused with 400 "model is not loaded" instead of pulling weights in
# under someone's session.
#
# Until 2026-11-06 this was three units -- light (:7070, autoload, several models),
# cheap (:7071, the shell helpers' model, isolated from LRU eviction) and heavy (:7072,
# one model, no autoload). The split existed to tame autoload's LRU eviction; with
# autoload off everywhere there is nothing to tame, and three routers that shared no
# memory budget were the shape of two global OOMs (docs/ryzen-llm-setup.md). One
# router, one model directory, one preset, one port.
#
# %h is systemd's own user-unit specifier for $HOME -- no install-time substitution
# needed for paths. Only @CPU_QUOTA@ and @THREADS@ are rendered by install.sh.
#   @CPU_QUOTA@     percentage for CPUQuota=, default 90 (see LOS_CPU_QUOTA)
#   @THREADS@       -t/--threads-batch value, default nproc/2 (see LOS_THREADS)

[Unit]
Description=llama.cpp router on :7070
Documentation=file:///home/olivier/dotfiles/docs/ryzen-llm-setup.md
After=graphical-session.target
# Every (re)start of this unit pulls in the resume helper, so a restart or a reboot
# does not leave every client pointing at an empty router. llama-router-restore.service
# declares After=llama-router.service and exits; Wants= is re-activated on each start,
# which is exactly the point -- Restart=on-failure does not restart its dependents, but
# it does re-run this line.
Wants=llama-router-restore.service

[Service]
Type=simple
# Pinned, not left to the default ~/.cache/llama.cpp: cached (-hf) models are
# enumerated unconditionally, ahead of --models-dir, so the cache decides part of the
# model list. Same name the Mac's launchd agent uses.
Environment=LLAMA_CACHE=%h/.cache/llama.cpp-router
# --models-max counts models, not bytes, and only matters as the point where an
# explicit load starts EVICTING the least-recently-used resident model (make_room in
# server-models.cpp). 8 puts that past anything the memory allows, so the router
# never unloads something you chose to keep: memory is the only budget, and it is
# read off the `los` header before loading.
#
# --host 0.0.0.0: pi/opencode address this box as oli-llms.local, which resolves to the
# LAN interface, not loopback. See docs/ryzen-llm-setup.md on exposure.
ExecStart=%h/dev/llama.cpp/build/bin/llama-server \
  --models-dir %h/models/llama \
  --models-preset %h/dotfiles/llamacpp/archlinux/models.ini \
  --models-max 8 \
  --no-models-autoload \
  --host 0.0.0.0 \
  --port 7070 \
  -to 3600 \
  --threads @THREADS@ \
  --threads-batch @THREADS@
# A cold load of a 90 GiB model must not be mistaken for a failed start.
TimeoutStartSec=0
Restart=on-failure
RestartSec=5

# Caps the router AND every model child it forks (CPUQuota applies to the unit's
# whole cgroup), so a long prompt-processing pass on the CPU fallback path cannot
# starve the rest of the desktop. GPU offload (ngl 999 in models.ini) means this
# rarely bites during generation, but it does during warmup/tokenization and any
# tensor llama.cpp keeps on the CPU. --threads/--threads-batch above cap ggml's own
# thread pool the same way. Override per-machine without editing this file:
# `systemctl --user edit llama-router.service`, or reinstall with
# LOS_CPU_QUOTA=<percent> and/or LOS_THREADS=<n> bash install.sh.
CPUQuota=@CPU_QUOTA@%

# ---- why this unit is the thing that "unloads your model" -------------------------
# MEASURED 2026-11-06: llama-router.service was oom-killed three times (15:01, 16:51,
# 23:30). Each one reads the same: the user.slice passed 50% memory pressure for >20 s,
# systemd-oomd considered 26 cgroups, picked this one (it holds by far the most
# reclaimable memory), SIGKILLed the whole unit, and `Restart=on-failure` brought the
# router back 5 s later -- with --no-models-autoload, so NOTHING resident. Every client
# then gets 400 "model is not loaded" until a human runs los-load. That is the model
# "unloading itself after a while"; it is not sleep-idle-seconds, which has never fired
# on this box (see the note in models.ini).
#
# ManagedOOMPreference=omit takes this unit out of oomd's candidate list. It does not
# make memory unlimited and it is a deliberate tradeoff: the victim moves to whatever
# else holds ordinary memory. A killed browser is recoverable; a killed router takes
# every model, every cached context and every in-flight agent session with it.
#
# OOMPolicy=continue is the kernel-side counterpart: if the kernel OOM killer picks a
# process inside this cgroup (a model child), keep the unit up instead of the default
# behaviour of stopping it -- the other models keep serving and the router survives.
ManagedOOMPreference=omit
OOMPolicy=continue

[Install]
WantedBy=default.target
