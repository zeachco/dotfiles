#!/bin/bash

# Herdr config helper.
#
# Herdr reads a single ~/.config/herdr/config.toml and its server rewrites parts
# of it (onboarding state, update channel; `herdr update` regenerates the whole
# file), so nothing here templates the file -- keys are patched in place. On
# macOS the file is Stow-linked from configs/herdr, so writes go *through* the
# symlink on purpose: replacing it would break the Stow link.
#
# The keymap has one source for every platform: configs/herdr/keys.toml.
# `ensure-keys` copies its [keys] table into config.toml, and `git-clean` (the
# clean filter registered by variants/shared/setup.sh) strips that table and
# the machine-local theme name back out of the stowed macOS copy so neither
# shows up as a diff.

set -e

DOTFILES_PATH="${DOTFILES_PATH:-$HOME/dotfiles}"
HERDR_CONFIG="${HERDR_CONFIG:-$HOME/.config/herdr/config.toml}"
HERDR_KEYMAP="${HERDR_KEYMAP:-$DOTFILES_PATH/configs/herdr/keys.toml}"

# Herdr's own built-in theme list (`herdr config check` rejects anything else).
# Themes with no match fall back to "terminal", which makes Herdr adopt the
# host terminal's palette -- already themed by themes/current/alacritty.toml.
DEFAULT_HERDR_THEME="terminal"

usage() {
  cat <<USAGE
Usage: herdr-config <command>

  set <section> <key> <toml-value>  Set one key, creating the section if needed
  set-theme <name>                  Set one of Herdr's built-in theme names
  sync-theme                        Apply themes/current/herdr-theme to Herdr
  ensure-keys                       Copy configs/herdr/keys.toml into Herdr's config
  git-clean                         Clean filter: stdin config -> stdout without the
                                    [keys] table and with theme.name pinned
USAGE
}

# Write stdin over the config without replacing the file, so a Stow-linked
# config keeps pointing at the dotfiles copy.
write_config() {
  mkdir -p "$(dirname "$HERDR_CONFIG")"
  cat >"$HERDR_CONFIG.tmp"
  cat "$HERDR_CONFIG.tmp" >"$HERDR_CONFIG"
  rm -f "$HERDR_CONFIG.tmp"
}

# Set section.key = value in config.toml, preserving everything else. TOML has
# no duplicate keys, so an existing key is replaced rather than appended.
toml_set() {
  local section="$1" key="$2" value="$3"

  mkdir -p "$(dirname "$HERDR_CONFIG")"
  [ -f "$HERDR_CONFIG" ] || : >"$HERDR_CONFIG"

  awk -v section="$section" -v key="$key" -v value="$value" '
    /^[[:space:]]*\[/ {
      # Leaving the target section without having seen the key: emit it here so
      # it stays inside the section rather than leaking into the next one.
      if (in_section && !done) { print key " = " value; done = 1 }
      cur = $0
      sub(/^[[:space:]]*\[+/, "", cur)
      sub(/\]+[[:space:]]*$/, "", cur)
      in_section = (cur == section)
    }
    {
      if (in_section && !done && $0 ~ "^[[:space:]]*" key "[[:space:]]*=") {
        print key " = " value
        done = 1
        next
      }
      print
    }
    END {
      if (!done) {
        if (!in_section) print "\n[" section "]"
        print key " = " value
      }
    }
  ' "$HERDR_CONFIG" | write_config
}

# stdin -> stdout without the [keys] table. Blank lines right above the table
# and at the end go too, so a config that ensure-keys appended the table to
# compares equal to one that never had it. Sub-tables such as [[keys.command]]
# are separate headers and are left alone.
strip_keys() {
  awk '
    function flush() { for (i = 0; i < blanks; i++) print ""; blanks = 0 }
    /^[[:space:]]*$/ { if (!in_keys) blanks++; next }
    /^[[:space:]]*\[/ {
      if ($0 ~ /^[[:space:]]*\[keys\][[:space:]]*$/) { in_keys = 1; blanks = 0; next }
      in_keys = 0
    }
    !in_keys { flush(); print }
  '
}

# The [keys] table of the keymap file: from its header to the next header or
# the end of the file, comments included.
keys_table() {
  awk '
    /^[[:space:]]*\[/ { in_keys = ($0 ~ /^[[:space:]]*\[keys\][[:space:]]*$/) }
    in_keys
  ' "$HERDR_KEYMAP"
}

reload() {
  command -v herdr >/dev/null 2>&1 || return 0
  herdr server reload-config >/dev/null 2>&1 || true
}

set_theme() {
  toml_set theme name "\"$1\""
  reload
}

sync_theme() {
  local theme_file="$DOTFILES_PATH/themes/current/herdr-theme"
  local name="$DEFAULT_HERDR_THEME"
  [ -f "$theme_file" ] && name=$(tr -d '[:space:]' <"$theme_file")
  [ -n "$name" ] || name="$DEFAULT_HERDR_THEME"

  set_theme "$name"
  echo "Herdr theme: $name"
}

# Replace the live [keys] table with the one from configs/herdr/keys.toml.
# Whole-table replacement (rather than key-by-key patching) means a binding
# removed from the keymap disappears from the machine too.
ensure_keys() {
  if [ ! -f "$HERDR_KEYMAP" ]; then
    echo "herdr-config: keymap not found: $HERDR_KEYMAP" >&2
    exit 1
  fi
  if ! keys_table | grep -q '^[[:space:]]*\[keys\]'; then
    echo "herdr-config: no [keys] table in $HERDR_KEYMAP" >&2
    exit 1
  fi

  mkdir -p "$(dirname "$HERDR_CONFIG")"
  [ -f "$HERDR_CONFIG" ] || : >"$HERDR_CONFIG"
  local rest
  rest=$(strip_keys <"$HERDR_CONFIG")
  {
    if [ -n "$rest" ]; then printf '%s\n\n' "$rest"; fi
    keys_table
  } | write_config

  reload
  if command -v herdr >/dev/null 2>&1; then
    herdr config check
  fi
  echo "Herdr keys: applied $HERDR_KEYMAP"
}

# git clean filter for the stowed configs/herdr copy: drop the [keys] table
# (owned by keys.toml) and pin theme.name (machine state set by theme-switch).
git_clean() {
  strip_keys |
    sed -E "/^\[theme\]/,/^\[/ s/^name = \".*\"/name = \"$DEFAULT_HERDR_THEME\"/"
}

case "${1:-}" in
set)
  shift
  [ $# -eq 3 ] || { usage; exit 1; }
  toml_set "$1" "$2" "$3"
  ;;
set-theme)
  shift
  [ $# -eq 1 ] || { usage; exit 1; }
  set_theme "$1"
  ;;
sync-theme) sync_theme ;;
ensure-keys) ensure_keys ;;
git-clean) git_clean ;;
*) usage; exit 1 ;;
esac
