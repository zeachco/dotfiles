#!/usr/bin/env bash
# One long-running step of a dotfiles update, run inside its own Herdr workspace.
#
# `setup.sh` fans out when it runs inside Herdr (HERDR_ENV=1, `herdr` on PATH):
# it opens one workspace per job below, runs this script in each, and polls the
# rc file it leaves behind -- so a system update, a llama.cpp rebuild and the
# profile installation no longer serialise behind each other. The main thread
# closes the workspaces once every job has written its rc (see herdr_fan_out in
# utils.sh).
#
# Usage: dotfiles-job <sysupdate|llamacpp|models|profile> <rc-dir>
#
#   sysupdate  system packages (omarchy update / pacman -Syu); Arch only today
#   llamacpp   llamacpp/<variant>/setup.sh (pull + rebuild + router install)
#   models     bin/llamacpp-fetch-missing: lists the GGUFs the per-OS fetch recipe
#              wants that are not on disk and downloads them after a [y/N] in the
#              pane (declined / unanswered = rc 0, nothing fetched). Only on the two
#              local-LLM boxes (llamacpp/shared/_hw-gate.sh).
#   profile    setup.sh itself with the two steps above skipped
#              (DOTFILES_SKIP_SYSUPDATE / DOTFILES_SKIP_LLAMACPP), DOTFILES_JOB set
#              so it does not fan out again.
#
# The exit code lands in <rc-dir>/<job>.rc; the pane prints it too so a failure is
# readable in place. Deliberately never exits the pane's shell: the main thread
# closes a successful workspace and leaves a failed one open for inspection.
set -u

job="${1:?job name}"
rc_dir="${2:?rc dir}"
. "$HOME/dotfiles/utils.sh"

export DOTFILES_JOB="$job"
echo -e "${INFO}dotfiles job ${NORM}$job"
case "$job" in
  sysupdate) system_update ;;
  llamacpp) bash "$DOT_DIR/llamacpp/$(dotfiles_variant)/setup.sh" ;;
  models) bash "$DOT_DIR/bin/llamacpp-fetch-missing" ;;
  profile) DOTFILES_SKIP_SYSUPDATE=1 DOTFILES_SKIP_LLAMACPP=1 "$SHELL" "$DOT_DIR/setup.sh" ;;
  *)
    echo -e "${FAIL}unknown job: $job${NORM}"
    false
    ;;
esac
rc=$?

mkdir -p "$rc_dir"
echo "$rc" >"$rc_dir/$job.rc"
if [[ $rc -eq 0 ]]; then
  echo -e "${PASS}dotfiles job $job done${NORM}"
else
  echo -e "${FAIL}dotfiles job $job failed (rc $rc)${NORM}"
fi
exit "$rc"
